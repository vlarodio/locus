#!/usr/bin/env bash
set -euo pipefail

source "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/locus-env.sh"

spin() {
  local pid="$1" msg="$2" i=0
  local -a frames=( '|' '/' '-' '\' )
  while kill -0 "$pid" 2>/dev/null; do
    printf '\r%s %s' "$msg" "${frames[$((i++ % 4))]}" >&2
    sleep 0.1
  done
  printf '\r\033[K' >&2
}

mkdir -p "$ROOT/workspace"

MOUNT_ARGS=()
if [ -f "$LOCUS_MOUNTS_FILE" ]; then
  while IFS= read -r path || [ -n "${path:-}" ]; do
    [ -n "$path" ] || continue
    case "$path" in
      /*) ;;
      *) printf 'locus: mount path must be absolute: %s\n' "$path" >&2; exit 1 ;;
    esac
    case "$path" in
      *:*) printf 'locus: mount path contains ":" and cannot be used: %s\n' "$path" >&2; exit 1 ;;
    esac
    if locus_protected_path "$path"; then
      printf 'locus: refusing to mount protected path: %s\n' "$path" >&2
      printf 'locus: remove with: make umount DIR=%q\n' "$path" >&2
      exit 1
    fi
    if [ ! -d "$path" ]; then
      printf 'locus: mount source is not a directory: %s\n' "$path" >&2
      printf 'locus: remove with: make umount DIR=%q\n' "$path" >&2
      exit 1
    fi
    MOUNT_ARGS+=(--volume "$path:$path")
  done < "$LOCUS_MOUNTS_FILE"
fi

IMAGE="$LOCUS_IMAGE"

CURRENT_HASH="$(docker image inspect --format '{{ index .Config.Labels "org.locus.build-hash" }}' "$IMAGE" 2>/dev/null || true)"

if [ "$CURRENT_HASH" != "$BUILD_HASH" ]; then
  if [ -t 2 ]; then
    "${LOCUS_COMPOSE[@]}" -p "$LOCUS_PROJECT" build --quiet &
    build_pid=$!
    spin "$build_pid" "locus: building image"
    wait "$build_pid"
  else
    "${LOCUS_COMPOSE[@]}" -p "$LOCUS_PROJECT" build --quiet
  fi
fi

if [ -t 0 ] && [ -t 1 ]; then
  printf 'locus: starting container...\n' >&2
  exec "${LOCUS_COMPOSE[@]}" -p "$LOCUS_PROJECT" run --rm "${MOUNT_ARGS[@]}" sandbox "$@"
else
  exec "${LOCUS_COMPOSE[@]}" -p "$LOCUS_PROJECT" run --rm -T "${MOUNT_ARGS[@]}" sandbox "$@"
fi
